# Copy this file to .env.local and fill in values. Never commit .env.local.
#
# Variables starting with NEXT_PUBLIC_ are sent to the browser, so only
# put non-secret values in them. Secret keys (added in later phases) will
# NOT have that prefix and will only ever be used on the server.

# --- Phase 1 (all optional) -------------------------------------------------

# Base map style for the globe. Default: OpenFreeMap "liberty" (free, no key).
# Other free options: https://tiles.openfreemap.org/styles/positron (lighter)
#                     https://tiles.openfreemap.org/styles/bright
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Contact info sent to Wikidata when you run `npm run data:fetch`
# (Wikimedia asks automated tools to identify themselves).
# WIKIMEDIA_CONTACT=you@example.com
