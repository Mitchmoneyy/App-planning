# Copy this file to .env.local and fill in what you need. Never commit .env.local.
#
# Variables starting with NEXT_PUBLIC_ are sent to the browser, so they must
# never hold secrets. Everything else stays on the server.
#
# The app runs with NONE of these set: it uses a built-in development
# database saved to .data/db.json, and simple built-in moderation rules.

# --- Database (production) ---------------------------------------------------
# Any PostgreSQL connection string. With Supabase: Project Settings → Database →
# Connection string → "Transaction pooler" (port 6543). Then run: npm run db:migrate
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# --- Privacy -------------------------------------------------------------------
# Encrypts private prayers in the database. Generate with: openssl rand -base64 32
# Keep it safe: if you lose it, existing private prayers can't be read.
# PRAYER_ENCRYPTION_KEY=

# --- Moderation ------------------------------------------------------------------
# Turns on AI moderation of shared prayers and reviews (Claude). Get a key at
# https://console.anthropic.com. Without it, only the built-in rules run.
# ANTHROPIC_API_KEY=
# Optional: a different Claude model for moderation (default: claude-opus-5-5).
# MODERATION_MODEL=

# Emails (comma-separated) of accounts that can use the moderation page at /admin.
# ADMIN_EMAILS=you@example.com

# --- Optional ----------------------------------------------------------------------
# Booking.com affiliate id, added to "Find places to stay" links.
# NEXT_PUBLIC_BOOKING_AFFILIATE_ID=

# Base map style for the globe. Default: OpenFreeMap "liberty" (free, no key).
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Contact sent to Wikimedia with API requests (they ask apps to identify themselves).
# WIKIMEDIA_CONTACT=you@example.com

# --- Notifications ---------------------------------------------------------------
# Your site's public address (used for links in emails and push notifications).
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Email via Resend (https://resend.com). EMAIL_FROM must be a verified sender.
# RESEND_API_KEY=
# EMAIL_FROM=Global Sanctuary <hello@yourdomain.com>

# Browser push. Generate a pair with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- Immersive views (optional) ----------------------------------------------------
# Google Street View: a server key (Street View metadata) and a browser key for the
# Maps Embed API, restricted to your domain in Google Cloud.
# GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Mapillary 360° street photos (free client token from https://www.mapillary.com/dashboard/developers)
# MAPILLARY_ACCESS_TOKEN=
