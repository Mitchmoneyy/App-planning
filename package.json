{
  "name": "global-sanctuary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "data:curated": "node scripts/build-curated.mjs",
    "data:fetch": "node --env-file-if-exists=.env.local scripts/fetch-wikidata.mjs",
    "data:land": "node scripts/build-land.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "db:places": "node --env-file-if-exists=.env.local scripts/db-load-places.mjs",
    "data:tiles": "node --max-old-space-size=12000 pipeline/build.mjs",
    "data:base-tiles": "python3 scripts/build-base-tiles.py",
    "data:glyphs": "node scripts/build-glyphs.mjs",
    "test": "vitest run",
    "data:cities": "node scripts/build-cities.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@mapbox/vector-tile": "^2.0.5",
    "@photostructure/tz-lookup": "^11.7.0",
    "mapbox-gl": "^3.33.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.4.3",
    "pbf": "^4.0.2",
    "pmtiles": "^4.5.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "supercluster": "^9.1.0",
    "three": "^0.186.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supercluster": "^7.1.3",
    "@types/three": "^0.186.0",
    "@types/web-push": "^3.6.4",
    "all-the-cities": "^3.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "geojson-vt": "^5.0.4",
    "maplibre-font-maker-node": "^0.5.0",
    "topojson-client": "^3.1.0",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "vt-pbf": "^3.1.3",
    "world-atlas": "^2.0.2"
  }
}
