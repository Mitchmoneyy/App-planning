{
  "expo": {
    "name": "Global Sanctuary",
    "slug": "global-sanctuary",
    "scheme": "globalsanctuary",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#05070f",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#05070f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.globalsanctuary"
    },
    "android": {
      "package": "app.globalsanctuary",
      "adaptiveIcon": {
        "backgroundColor": "#0b1020",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#d9b26f"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Global Sanctuary uses your location to show places of worship near you. It's never shared."
        }
      ],
      "@rnmapbox/maps"
    ],
    "extra": {
      "siteUrl": "https://your-global-sanctuary.vercel.app",
      "mapboxToken": ""
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
